// Gutters AI Estimator — database schema
//
// Conventions:
// - All tables snake_case via @@map; field names camelCase in code.
// - Money stored as Decimal(12,2) in USD. Never use floats for money.
// - Soft-delete via `deletedAt` where it exists; otherwise hard delete.
// - Timestamps default to now() and update on @updatedAt where present.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) URL for migrations. PgBouncer-style poolers
  // can't run schema migrations. Vercel's Neon integration auto-injects
  // DATABASE_URL_UNPOOLED, so this name lines up zero-config.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------------------------
// Auth (Auth.js / NextAuth-compatible shape)
// -----------------------------------------------------------------------

enum UserRole {
  CONTRACTOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  clerkId       String?    @unique
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole   @default(CONTRACTOR)
  status        UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  accounts          Account[]
  sessions          Session[]
  contractorProfile ContractorProfile?
  subscription      Subscription?
  creditWallet      CreditWallet?
  proposals         Proposal[]
  estimateRuns      EstimateRun[]
  transactions      Transaction[]
  auditLogs         AuditLog[]            @relation("ActorAudits")
  impersonations    ImpersonationSession[] @relation("AdminImpersonator")
  impersonated      ImpersonationSession[] @relation("ImpersonatedUser")
  leadInteractions  UserLeadInteraction[]
  planAnalyses      PlanAnalysis[]
  appointments      Appointment[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------
// Contractor profile (logo + company info shown on proposals)
// -----------------------------------------------------------------------

model ContractorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  company         String
  contractorName  String
  email           String
  phone           String
  license         String
  tagline         String?
  logoInitials    String   @default("GU")
  logoTone        String   @default("emerald")
  logoUrl         String?  @db.Text
  stripeAccountId String?  @unique
  // Public payment URLs the contractor pastes in (Stripe Payment Link,
  // Square checkout link, etc). Surfaced as "Pay now" on accepted proposals.
  stripePaymentUrl String?
  squarePaymentUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contractor_profiles")
}

// -----------------------------------------------------------------------
// Subscriptions + credits
// -----------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  status               SubscriptionStatus @default(TRIALING)
  planId               String             @default("pro_monthly")
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  included  Int      @default(12)
  used      Int      @default(0)
  bonus     Int      @default(0)
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

// -----------------------------------------------------------------------
// Estimate runs (one per address-time, tracks AI calls and dedup)
// -----------------------------------------------------------------------

enum EstimateRunStatus {
  QUEUED
  SUCCEEDED
  FAILED
}

model EstimateRun {
  id                String            @id @default(cuid())
  userId            String
  address           String
  addressNormalized String
  status            EstimateRunStatus @default(QUEUED)
  creditConsumed    Boolean           @default(false)
  reused            Boolean           @default(false)
  errorMessage      String?           @db.Text
  durationMs        Int?
  apiCostCents      Int?
  measurements      Json?
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, addressNormalized, createdAt])
  @@index([status])
  @@map("estimate_runs")
}

// -----------------------------------------------------------------------
// Plan analyses (PDF/image construction plans → AI gutter blueprint)
//
// A contractor uploads a roof plan and Claude returns a structured layout:
// every gutter run + downspout + excluded rake. We store the original file
// bytes (base64 in `originalData`) so the renderer can show the source
// alongside the AI overlay, plus the raw AI JSON in `analysisJson`.
//
// `editedJson` is null until the contractor manually edits — keeping the
// original AI output untouched lets us A/B test prompt changes against
// real ground-truth contractor corrections.
// -----------------------------------------------------------------------

enum PlanAnalysisStatus {
  QUEUED
  SUCCEEDED
  FAILED
}

model PlanAnalysis {
  id              String              @id @default(cuid())
  userId          String
  status          PlanAnalysisStatus  @default(QUEUED)
  // Source file: filename, mime, raw bytes (base64). PDFs are stored as the
  // original PDF; we also store the rasterized page images in `pageImages`.
  filename        String
  mimeType        String
  originalData    String?             @db.Text
  pageImages      Json?               // Array of { dataUrl, width, height, pageIndex }
  pageCount       Int?
  // AI output
  analysisJson    Json?               // Raw Claude response (BlueprintResult)
  editedJson      Json?               // Contractor-edited version (null until edited)
  confidence      String?             // "high" | "medium" | "low"
  // Telemetry
  modelUsed       String?             // e.g. "claude-sonnet-4-6"
  inputTokens     Int?
  outputTokens   Int?
  cacheHit        Boolean             @default(false)
  durationMs      Int?
  errorMessage    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("plan_analyses")
}

// -----------------------------------------------------------------------
// Proposals (cover, packages, photos, terms — JSON snapshot)
// -----------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Proposal {
  id                String         @id @default(cuid())
  userId            String
  publicToken       String         @unique @default(cuid())
  address           String
  clientName        String
  clientEmail       String
  status            ProposalStatus @default(DRAFT)
  selectedPackageId String?
  totalCents        Int            @default(0)
  paidCents         Int            @default(0)
  data              Json
  contractorSnap    Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sentAt            DateTime?
  acceptedAt        DateTime?
  expiresAt         DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       ProposalEvent[]
  transactions Transaction[]
  appointments Appointment[]

  @@index([userId, status])
  @@index([publicToken])
  @@map("proposals")
}

enum ProposalEventKind {
  DRAFTED
  SENT
  VIEWED
  PACKAGE_SELECTED
  SIGNED
  ACCEPTED
  PAID
  DECLINED
  EXPIRED
}

model ProposalEvent {
  id         String            @id @default(cuid())
  proposalId String
  kind       ProposalEventKind
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_events")
}

// -----------------------------------------------------------------------
// Transactions (Stripe Billing for SaaS, Stripe Connect for proposal pay)
// -----------------------------------------------------------------------

enum TransactionType {
  SUBSCRIPTION
  PROPOSAL_DEPOSIT
  PROPOSAL_FINAL
  REFUND
  CREDIT_TOPUP
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String
  proposalId            String?
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  grossCents            Int
  platformFeeCents      Int               @default(0)
  netCents              Int
  currency              String            @default("usd")
  stripePaymentIntentId String?           @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  description           String?
  createdAt             DateTime          @default(now())
  settledAt             DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([proposalId])
  @@index([status])
  @@map("transactions")
}

// -----------------------------------------------------------------------
// Admin: audit log + impersonation
// -----------------------------------------------------------------------

enum AuditAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_CREDITS_ADJUSTED
  USER_IMPERSONATED
  USER_IMPERSONATION_ENDED
  REFUND_ISSUED
  API_KEY_CREATED
  API_KEY_ROTATED
  API_KEY_REVOKED
  API_KEY_VIEWED
  PRICING_UPDATED
  MATERIAL_DEFAULTS_UPDATED
  PROMPT_TEMPLATE_UPDATED
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType String?
  targetId   String?
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User @relation("ActorAudits", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ImpersonationSession {
  id              String    @id @default(cuid())
  adminId         String
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  reason          String?

  admin User @relation("AdminImpersonator", fields: [adminId], references: [id], onDelete: Cascade)
  user  User @relation("ImpersonatedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([userId])
  @@map("impersonation_sessions")
}

// -----------------------------------------------------------------------
// Admin: API key vault (encrypted at rest)
// -----------------------------------------------------------------------

enum ApiKeyProvider {
  GOOGLE_MAPS
  GOOGLE_SOLAR
  MAPBOX
  OPENAI
  FAL
  NEARMAP
  EAGLEVIEW
  RESEND
  STRIPE_SECRET
  STRIPE_WEBHOOK
  SOCRATA
  ANTHROPIC
}

model ApiKey {
  id             String         @id @default(cuid())
  provider       ApiKeyProvider
  label          String
  encryptedValue String         @db.Text
  fingerprint    String
  active         Boolean        @default(true)
  lastUsedAt     DateTime?
  rotatedAt      DateTime?
  createdAt      DateTime       @default(now())
  createdBy      String

  // Same Google Cloud key may legitimately power both GOOGLE_MAPS and
  // GOOGLE_SOLAR slots, so uniqueness is scoped to the provider.
  @@unique([provider, fingerprint])
  @@index([provider, active])
  @@map("api_keys")
}

// -----------------------------------------------------------------------
// Admin: pricing CMS + global material defaults
// -----------------------------------------------------------------------

enum PricingPlanInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model PricingPlan {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  tagline             String?
  priceCents          Int
  interval            PricingPlanInterval @default(MONTHLY)
  includedCredits     Int                 @default(0)
  extraCreditPriceCents Int               @default(500)
  features            Json
  active              Boolean             @default(true)
  stripePriceId       String?             @unique
  stripeProductId     String?
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("pricing_plans")
}

model MaterialDefault {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  category     String
  unit         String
  priceCents   Int
  description  String?
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@map("material_defaults")
}

/// Admin-editable AI prompt overrides. Keyed by a stable prompt key
/// (see lib/ai/prompts.ts). When a row exists, the pipeline uses its
/// `content`; otherwise it falls back to the hardcoded default in code.
model PromptTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  category  String // "address" | "blueprint"
  content   String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("prompt_templates")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("platform_settings")
}

// -----------------------------------------------------------------------
// Leads / Permits Tracking
// -----------------------------------------------------------------------

enum LeadStatus {
  APPLIED
  UNDER_REVIEW
  ISSUED
  INSPECTION
  FINALED
  UNKNOWN
}

model Lead {
  id                  String       @id @default(cuid())
  sourceId            String       // The ID from the city API
  sourceCity          String       // e.g. "Seattle", "Kirkland"
  address             String
  originalDescription String       @db.Text
  categorizedTrade    String?      // e.g. "Roofing", "Gutters", "Framing"
  buildingType        String?      // "Residential", "Commercial", "Multi-family", …
  projectKind         String?      // "New Construction" | "Remodel/Addition" | "Tenant Improvement" | "Demolition" | "Other"
  contractorName     String?      // Company doing the permitted work, if disclosed
  ownerName           String?      // Property owner, when the feed publishes it
  fixtures            String?      // Comma-separated work items / fixtures
  workClass           String?      // Raw work-class from source (e.g. "New Structure")
  aiSummary           String?      @db.Text  // Plain-English one-liner from the AI
  aiRelevance         String?      // "high" | "medium" | "low" — gutter-business relevance
  status              LeadStatus   @default(UNKNOWN)
  latitude            Float
  longitude           Float
  projectValue        Int?         // raw dollars, as reported by the source permit feed
  issuedDate          DateTime?    // When the municipality issued the permit (from source feed)
  housingUnits        Int?         // # of dwelling units the permit creates / affects
  developmentType     String?      // "Single Family" | "Duplex" | "Townhouse" | "Condo" | "Multifamily" | "Plat" | "Short Plat" | "ADU" | …
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  interactions        UserLeadInteraction[]
  appointments        Appointment[]

  @@unique([sourceCity, sourceId]) // Prevents duplicate imports from the same city
  @@index([latitude, longitude])
  @@index([categorizedTrade, status])
  @@index([buildingType])
  @@index([projectKind])
  @@index([issuedDate])
  @@index([developmentType])
  @@map("leads")
}

enum InteractionStatus {
  UNREAD
  VISITED
  CONTACTED
  BIDDING
  NOT_INTERESTED
}

model UserLeadInteraction {
  id        String            @id @default(cuid())
  userId    String
  leadId    String
  status    InteractionStatus @default(UNREAD)
  notes     String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId])
  @@map("user_lead_interactions")
}

enum AppointmentType {
  LEAD_VISIT
  JOB_INSTALL
  PROPOSAL_MEETING
  FOLLOW_UP
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Calendar entry. Powers /dashboard/calendar — lead site visits, gutter
// installs scheduled off a sent proposal, and ad-hoc follow-ups all
// share this table. leadId / proposalId are optional links back to the
// source row so the calendar can show "Site visit for X permit" or
// "Install for Y proposal" with a deep link.
model Appointment {
  id          String            @id @default(cuid())
  userId      String
  title       String
  type        AppointmentType   @default(OTHER)
  status      AppointmentStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  address     String?
  notes       String?           @db.Text
  // Optional per-event color override. When null the UI picks by type.
  colorHex    String?
  // Cached client contact so the calendar tile can show name/phone
  // without joining; pre-filled from lead/proposal when present.
  clientName  String?
  clientPhone String?
  clientEmail String?

  leadId     String?
  proposalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([leadId])
  @@index([proposalId])
  @@map("appointments")
}
