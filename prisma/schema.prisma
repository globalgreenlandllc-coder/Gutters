// Gutters AI Estimator — database schema
//
// Conventions:
// - All tables snake_case via @@map; field names camelCase in code.
// - Money stored as Decimal(12,2) in USD. Never use floats for money.
// - Soft-delete via `deletedAt` where it exists; otherwise hard delete.
// - Timestamps default to now() and update on @updatedAt where present.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon's pooled connection. Uncomment if you split pooled/direct:
  // directUrl = env("DATABASE_URL_DIRECT")
}

// -----------------------------------------------------------------------
// Auth (Auth.js / NextAuth-compatible shape)
// -----------------------------------------------------------------------

enum UserRole {
  CONTRACTOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole   @default(CONTRACTOR)
  status        UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  accounts          Account[]
  sessions          Session[]
  contractorProfile ContractorProfile?
  subscription      Subscription?
  creditWallet      CreditWallet?
  proposals         Proposal[]
  estimateRuns      EstimateRun[]
  transactions      Transaction[]
  auditLogs         AuditLog[]            @relation("ActorAudits")
  impersonations    ImpersonationSession[] @relation("AdminImpersonator")
  impersonated      ImpersonationSession[] @relation("ImpersonatedUser")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------
// Contractor profile (logo + company info shown on proposals)
// -----------------------------------------------------------------------

model ContractorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  company         String
  contractorName  String
  email           String
  phone           String
  license         String
  tagline         String?
  logoInitials    String   @default("GU")
  logoTone        String   @default("emerald")
  stripeAccountId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contractor_profiles")
}

// -----------------------------------------------------------------------
// Subscriptions + credits
// -----------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  status               SubscriptionStatus @default(TRIALING)
  planId               String             @default("pro_monthly")
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  included  Int      @default(12)
  used      Int      @default(0)
  bonus     Int      @default(0)
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

// -----------------------------------------------------------------------
// Estimate runs (one per address-time, tracks AI calls and dedup)
// -----------------------------------------------------------------------

enum EstimateRunStatus {
  QUEUED
  SUCCEEDED
  FAILED
}

model EstimateRun {
  id                String            @id @default(cuid())
  userId            String
  address           String
  addressNormalized String
  status            EstimateRunStatus @default(QUEUED)
  creditConsumed    Boolean           @default(false)
  reused            Boolean           @default(false)
  errorMessage      String?           @db.Text
  durationMs        Int?
  apiCostCents      Int?
  measurements      Json?
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, addressNormalized, createdAt])
  @@index([status])
  @@map("estimate_runs")
}

// -----------------------------------------------------------------------
// Proposals (cover, packages, photos, terms — JSON snapshot)
// -----------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Proposal {
  id                String         @id @default(cuid())
  userId            String
  publicToken       String         @unique @default(cuid())
  address           String
  clientName        String
  clientEmail       String
  status            ProposalStatus @default(DRAFT)
  selectedPackageId String?
  totalCents        Int            @default(0)
  paidCents         Int            @default(0)
  data              Json
  contractorSnap    Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sentAt            DateTime?
  acceptedAt        DateTime?
  expiresAt         DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       ProposalEvent[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([publicToken])
  @@map("proposals")
}

enum ProposalEventKind {
  DRAFTED
  SENT
  VIEWED
  PACKAGE_SELECTED
  SIGNED
  ACCEPTED
  PAID
  DECLINED
  EXPIRED
}

model ProposalEvent {
  id         String            @id @default(cuid())
  proposalId String
  kind       ProposalEventKind
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_events")
}

// -----------------------------------------------------------------------
// Transactions (Stripe Billing for SaaS, Stripe Connect for proposal pay)
// -----------------------------------------------------------------------

enum TransactionType {
  SUBSCRIPTION
  PROPOSAL_DEPOSIT
  PROPOSAL_FINAL
  REFUND
  CREDIT_TOPUP
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String
  proposalId            String?
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  grossCents            Int
  platformFeeCents      Int               @default(0)
  netCents              Int
  currency              String            @default("usd")
  stripePaymentIntentId String?           @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  description           String?
  createdAt             DateTime          @default(now())
  settledAt             DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([proposalId])
  @@index([status])
  @@map("transactions")
}

// -----------------------------------------------------------------------
// Admin: audit log + impersonation
// -----------------------------------------------------------------------

enum AuditAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_CREDITS_ADJUSTED
  USER_IMPERSONATED
  USER_IMPERSONATION_ENDED
  REFUND_ISSUED
  API_KEY_CREATED
  API_KEY_ROTATED
  API_KEY_REVOKED
  API_KEY_VIEWED
  PRICING_UPDATED
  MATERIAL_DEFAULTS_UPDATED
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType String?
  targetId   String?
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User @relation("ActorAudits", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ImpersonationSession {
  id              String    @id @default(cuid())
  adminId         String
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  reason          String?

  admin User @relation("AdminImpersonator", fields: [adminId], references: [id], onDelete: Cascade)
  user  User @relation("ImpersonatedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([userId])
  @@map("impersonation_sessions")
}

// -----------------------------------------------------------------------
// Admin: API key vault (encrypted at rest)
// -----------------------------------------------------------------------

enum ApiKeyProvider {
  GOOGLE_MAPS
  GOOGLE_SOLAR
  OPENAI
  NEARMAP
  EAGLEVIEW
  RESEND
  STRIPE_SECRET
  STRIPE_WEBHOOK
}

model ApiKey {
  id             String         @id @default(cuid())
  provider       ApiKeyProvider
  label          String
  encryptedValue String         @db.Text
  fingerprint    String         @unique
  active         Boolean        @default(true)
  lastUsedAt     DateTime?
  rotatedAt      DateTime?
  createdAt      DateTime       @default(now())
  createdBy      String

  @@index([provider, active])
  @@map("api_keys")
}

// -----------------------------------------------------------------------
// Admin: pricing CMS + global material defaults
// -----------------------------------------------------------------------

enum PricingPlanInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model PricingPlan {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  tagline             String?
  priceCents          Int
  interval            PricingPlanInterval @default(MONTHLY)
  includedCredits     Int                 @default(0)
  extraCreditPriceCents Int               @default(500)
  features            Json
  active              Boolean             @default(true)
  stripePriceId       String?             @unique
  stripeProductId     String?
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("pricing_plans")
}

model MaterialDefault {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  category     String
  unit         String
  priceCents   Int
  description  String?
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@map("material_defaults")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("platform_settings")
}
